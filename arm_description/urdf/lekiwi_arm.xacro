    iyz="0.00024876935781550404"
    ixz="-1.4799628966957228e-07"
    visual_xyz="-0.058051990747593187 0.039999997308103726 -0.0024000000000000644"
    visual_rpy="1.5707963267948968 6.378522481755146e-34 -4.712388980384690"
    collision_xyz="-0.058051990747593187 0.039999997308103726 -0.0024000000000000644"
    collision_rpy="1.5707963267948968 6.378522481755146e-34 -4.712388980384690" />

  <!-- Connect base_link to base_link_physical with offset to joint1 axis -->
  <xacro:fixed_joint name="base_to_physical"
    parent="base_link"
    child="base_link_physical"
    xyz="0.012852 -0.04000 0.0"
    rpy="0.0 0.0 0.0" />

