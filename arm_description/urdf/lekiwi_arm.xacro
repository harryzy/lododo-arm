<?xml version="1.0"?>
<robot name="lekiwi_arm" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- ======================== GLOBAL CONSTANTS ======================== -->
  <xacro:property name="M_PI" value="3.141592653589793" />
  <!-- ======================== MATERIAL DEFINITIONS ======================== -->
  <material name="Black">
    <color rgba="0 0 0 1" />
  </material>
  <material name="White">
    <color rgba="1 1 1 1" />
  </material>
  <material name="Blue">
    <color rgba="0 0 1 1" />
  </material>
  <material name="Gray">
    <color rgba="0.5 0.5 0.5 1" />
  </material>
  <!-- ======================== XACRO PROPERTIES ======================== -->
  <!-- Mesh path prefix -->
  <xacro:property name="mesh_prefix" value="package://arm_description/urdf/meshes" />
  <!-- Inertial matrix macro -->
  <xacro:macro name="inertial_matrix" params="mass">
    <inertial>
      <mass value="${mass}" />
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="1.0" />
    </inertial>
  </xacro:macro>
  <!-- Mesh scale (all STL files use same scale) -->
  <xacro:property name="mesh_scale" value="0.001 0.001 0.001" />

  <!-- ======================== MACROS ======================== -->
  <!-- Macro for creating a link with mesh geometry -->
  <xacro:macro name="mesh_link"
    params="name mesh_file 
                                        inertial_xyz inertial_rpy mass 
                                        ixx iyy izz ixy iyz ixz
                                        visual_xyz visual_rpy
                                        collision_xyz collision_rpy">
    <link name="${name}">
      <inertial>
        <origin xyz="${inertial_xyz}" rpy="${inertial_rpy}" />
        <mass value="${mass}" />
        <inertia ixx="${ixx}" iyy="${iyy}" izz="${izz}"
          ixy="${ixy}" iyz="${iyz}" ixz="${ixz}" />
      </inertial>
      <visual name="${name}_visual">
        <origin xyz="${visual_xyz}" rpy="${visual_rpy}" />
        <geometry>
          <mesh filename="${mesh_prefix}/${mesh_file}" scale="${mesh_scale}" />
        </geometry>
        <material name="Gray" />
      </visual>
      <collision name="${name}_collision">
        <origin xyz="${collision_xyz}" rpy="${collision_rpy}" />
        <geometry>
          <mesh filename="${mesh_prefix}/${mesh_file}" scale="${mesh_scale}" />
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Macro for creating a fixed joint -->
  <xacro:macro name="fixed_joint" params="name parent child xyz rpy">
    <joint name="${name}" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent}" />
      <child link="${child}" />
    </joint>
  </xacro:macro>

  <!-- Macro for creating a continuous joint -->
  <xacro:macro name="continuous_joint" params="name parent child xyz rpy axis">
    <joint name="${name}" type="continuous">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent}" />
      <child link="${child}" />
      <axis xyz="${axis}" />
    </joint>
  </xacro:macro>

  <!-- Macro for creating a revolute joint -->
  <xacro:macro name="revolute_joint" params="name parent child xyz rpy axis lower upper effort velocity">
    <joint name="${name}" type="revolute">
      <origin xyz="${xyz}" rpy="${rpy}" />
      <parent link="${parent}" />
      <child link="${child}" />
      <axis xyz="${axis}" />
      <limit lower="${lower}" upper="${upper}" effort="${effort}" velocity="${velocity}" />
    </joint>
  </xacro:macro>

  <!-- ======================== BASE STRUCTURE ======================== -->
  <!-- Dummy root link to avoid KDL warning -->
  <link name="bottom_link">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <box size="1 1 0.02" />
      </geometry>
      <material name="Blue" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <box size="1 1 0.02" />
      </geometry>
    </collision>
    <xacro:inertial_matrix mass="500" />
  </link>

  <!-- Base Link with origin at joint1 axis (virtual link) -->
  <link name="base_link">
    <xacro:inertial_matrix mass="0.001" />
  </link>

  <xacro:fixed_joint name="bottom_joint"
    parent="base_link"
    child="bottom_link"
    xyz="0.0 0.0 0.0"
    rpy="0.0 0.0 0.0" />

  <!-- Physical base link (renamed to base_link_physical) -->
  <xacro:mesh_link name="base_link_physical"
    mesh_file="Base_08q-v1.stl"
    inertial_xyz="-0.03999704723368316 -0.03974905501648025 0.021865523723532104"
    inertial_rpy="0.0 0.0 0.0"
    mass="1.2829039880853146"
