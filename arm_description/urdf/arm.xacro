<?xml version="1.0"?>
<!-- Optimized robotic arm URDF for MoveIt2 -->
<robot name="arm" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ======================== GLOBAL CONSTANTS ======================== -->
  <xacro:property name="M_PI" value="3.14159" />
  <xacro:property name="COLLISION_SCALE" value="0.80" />

  <!-- ======================== MATERIAL DEFINITIONS ======================== -->
  <material name="Black">
    <color rgba="0 0 0 1" />
  </material>
  <material name="White">
    <color rgba="1 1 1 1" />
  </material>
  <material name="Blue">
    <color rgba="0 0 1 1" />
  </material>

  <!-- ======================== LINK DIMENSIONS ======================== -->
  <!-- Base -->
  <xacro:property name="BASE_SIZE" value="0.1 0.1 0.04" />

  <!-- Arm Links -->
  <xacro:property name="LINK1_RADIUS" value="0.0315" />
  <xacro:property name="LINK1_LENGTH" value="0.11" />

  <xacro:property name="LINK2_RADIUS" value="0.0325" />
  <xacro:property name="LINK2_LENGTH" value="0.1415" />

  <xacro:property name="LINK3_RADIUS" value="0.0325" />
  <xacro:property name="LINK3_LENGTH" value="0.13" />

  <xacro:property name="LINK4_RADIUS" value="0.0325" />
  <xacro:property name="LINK4_LENGTH" value="0.072" />

  <xacro:property name="LINK5_RADIUS" value="0.04" />
  <xacro:property name="LINK5_LENGTH" value="0.032" />

  <!-- Gripper -->
  <xacro:property name="GRIPPER_LENGTH" value="0.08" />
  <xacro:property name="GRIPPER_WIDTH" value="0.01" />
  <xacro:property name="GRIPPER_HEIGHT" value="0.01" />

  <!-- ======================== MACROS ======================== -->
  <!-- Inertial matrix macro -->
  <xacro:macro name="inertial_matrix" params="mass">
    <inertial>
      <mass value="${mass}" />
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="0.5" iyz="0.0" izz="1.0" />
    </inertial>
  </xacro:macro>

  <!-- Cylinder link macro -->
  <xacro:macro name="cylinder_link"
    params="name radius length visual_origin collision_origin material visual_rpy='0 0 0'">
    <link name="${name}">
      <visual>
        <origin xyz="${visual_origin}" rpy="${visual_rpy}" />
        <geometry>
          <cylinder radius="${radius}" length="${length}" />
        </geometry>
        <material name="${material}" />
      </visual>
      <collision>
        <origin xyz="${collision_origin}" rpy="${visual_rpy}" />
        <geometry>
          <cylinder radius="${radius * COLLISION_SCALE}" length="${length * COLLISION_SCALE}" />
        </geometry>
      </collision>
      <xacro:inertial_matrix mass="1" />
    </link>
  </xacro:macro>

  <!-- ======================== FIXED BASE ======================== -->
  <joint name="bottom_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="bottom_link" />
  </joint>

  <link name="bottom_link">
    <visual>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <box size="1 1 0.02" />
      </geometry>
      <material name="Blue" />
    </visual>
    <collision>
      <origin xyz="0 0 -0.02" rpy="0 0 0" />
      <geometry>
        <box size="1 1 0.02" />
      </geometry>
    </collision>
    <xacro:inertial_matrix mass="500" />
  </link>

  <!-- ======================== BASE LINK ======================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${BASE_SIZE}" />
      </geometry>
      <material name="White" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${BASE_SIZE}" />
      </geometry>
    </collision>
  </link>

  <!-- ======================== JOINT 1 ======================== -->
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.02" rpy="0 ${M_PI/2} 0" />
    <axis xyz="1 0 0" />
    <parent link="base_link" />
    <child link="link1" />
    <limit effort="300" velocity="1" lower="-2.96" upper="2.96" />
    <dynamics damping="50" friction="1" />
  </joint>

  <xacro:cylinder_link
    name="link1"
    radius="${LINK1_RADIUS}"
    length="${LINK1_LENGTH}"
    visual_origin="-${LINK1_LENGTH/2} 0 0"
    collision_origin="-${LINK1_LENGTH/2} 0 0"
    material="Black"
    visual_rpy="0 ${M_PI/2} 0"
  />

  <!-- ======================== JOINT 2 ======================== -->
  <joint name="joint2" type="revolute">
    <origin xyz="-${LINK1_LENGTH} 0 0.0" rpy="-${M_PI/2} 0 ${M_PI/2}" />
    <axis xyz="1 0 0" />
    <parent link="link1" />
    <child link="link2" />
    <limit effort="300" velocity="1" lower="-2.35" upper="2.35" />
    <dynamics damping="50" friction="1" />
  </joint>

  <xacro:cylinder_link
    name="link2"
    radius="${LINK2_RADIUS}"
    length="${LINK2_LENGTH}"
    visual_origin="0 0 ${LINK2_LENGTH/2}"
    collision_origin="0 0 ${LINK2_LENGTH/2}"
    material="White"
  />

  <!-- ======================== JOINT 3 ======================== -->
  <joint name="joint3" type="revolute">
    <origin xyz="0 0 ${LINK2_LENGTH}" rpy="0 ${M_PI} 0" />
    <axis xyz="-1 0 0" />
    <parent link="link2" />
    <child link="link3" />
    <limit effort="300" velocity="1" lower="-1.1" upper="3.01" />
    <dynamics damping="50" friction="1" />
  </joint>

  <xacro:cylinder_link
    name="link3"
    radius="${LINK3_RADIUS}"
    length="${LINK3_LENGTH}"
    visual_origin="0 0 -${LINK3_LENGTH/2}"
    collision_origin="0 0 -${LINK3_LENGTH/2}"
    material="Black"
  />

  <!-- ======================== JOINT 4 ======================== -->
  <joint name="joint4" type="revolute">
    <origin xyz="0 0 -${LINK3_LENGTH}" rpy="0 ${M_PI} 0" />
    <axis xyz="1 0 0" />
    <parent link="link3" />
    <child link="link4" />
    <limit effort="300" velocity="1" lower="-1.57" upper="1.57" />
    <dynamics damping="50" friction="1" />
  </joint>

  <xacro:cylinder_link
    name="link4"
    radius="${LINK4_RADIUS}"
    length="${LINK4_LENGTH}"
    visual_origin="0 0 ${LINK4_LENGTH/2}"
    collision_origin="0 0 ${LINK4_LENGTH/2}"
    material="White"
  />

  <!-- ======================== JOINT 5 ======================== -->
  <joint name="joint5" type="revolute">
    <origin xyz="0 0 ${LINK4_LENGTH}" rpy="${1.5*M_PI} -${M_PI/2} 0" />
    <axis xyz="1 0 0" />
    <parent link="link4" />
    <child link="link5" />
    <limit effort="300" velocity="1" lower="-3.14" upper="3.14" />
    <dynamics damping="50" friction="1" />
  </joint>

  <xacro:cylinder_link
    name="link5"
    radius="${LINK5_RADIUS}"
    length="${LINK5_LENGTH}"
    visual_origin="${LINK5_LENGTH/2} 0 0"
    collision_origin="${LINK5_LENGTH/2} 0 0"
    material="Black"
    visual_rpy="0 ${M_PI/2} 0"
  />
  <!-- ======================== camera_link ======================== -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.15" />
      <inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" />
      <geometry>
        <box size="0.04 0.04 0.025" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" />
      <geometry>
        <box size="0.04 0.04 0.025" />
      </geometry>
    </collision>
  </link>
  
  <!-- ======================== CAMERA JOINT ======================== -->
  <!-- 
    相机安装角度配置说明:
    
    【原始配置 - 为Gazebo仿真设计】
    <joint name="camera_joint" type="fixed">
      <parent link="link5" />
      <child link="camera_link" />
      <origin xyz="0 0 0.05" rpy="0 ${M_PI/4} 0" />
    </joint>
    
    问题: M_PI/4 = 45° 的俯仰角与真实硬件安装不符
    现象: 
      - 物体深度37cm时,计算X=17cm (实测应30-33cm)
      - Z坐标偏差大 (计算-11cm,实测应≈0cm)
    
    【修正配置 - 匹配真实硬件】
    根据实测数据反推:
      - 深度37cm → X应该30-33cm
      - 需要的角度: arccos(31/37) ≈ 33°
      - 但需要考虑optical_frame的额外旋转
    
    修正策略: 减小俯仰角从45°到30°
  -->
  <joint name="camera_joint" type="fixed">
    <parent link="link5" />
    <child link="camera_link" />
    <!-- 原始: xyz="0 0 0.05" rpy="0 ${M_PI/4} 0" (5cm高,45°仿真用) -->
    <!-- 调优记录与结论:
         【最终测试结果】
         25°+5.0cm → X=29.2cm, Z=8.3cm
         25°+1.5cm → X=28.2cm, Z=4.1cm ← 最佳Z坐标
         23°+1.5cm → X=28.5cm, Z=5.7cm
         
         【发现】:
         - X和Z存在矛盾,无法通过URDF同时满足X=30-33cm和Z=0-3cm
         - 25°+1.5cm配置下Z=4.1cm是最接近目标的
         - X=28.2cm距离目标30cm差1.8cm
         
         【最终方案】:
         - URDF使用25°+1.5cm(优先保证Z坐标准确)
         - 代码中添加X坐标补偿+2cm来修正
    -->
    <!-- 最终配置: 25°角度 + 1.5cm高度 (25° ≈ 0.436 rad) -->
    <origin xyz="0 0 0.015" rpy="0 0.436 0" />
  </joint>
  
  <link name="camera_optical_frame" />
  
  <!-- 
    camera_optical_frame 定义:
    标准ROS camera_optical_frame坐标系:
      - X轴: 向右
      - Y轴: 向下  
      - Z轴: 向前(光轴方向)
    
    rpy="-1.570796 0 -1.570796" 即 (-90° 0° -90°)
    这个旋转将camera_link坐标系转换为optical_frame坐标系
  -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796" />
  </joint>

  <!-- ======================== GRIPPER JOINTS ======================== -->
  <joint name="finger_joint1" type="revolute">
    <origin xyz="0.0 0 0" rpy="${M_PI}  0 -1.5708" />
    <axis xyz="0 0 1" />
    <parent link="link5" />
    <child link="gripper_finger_link1" />
    <limit effort="100" lower="-1.5708" upper="0" velocity="1.0" />
    <dynamics damping="50" friction="1" />
  </joint>

  <!-- Left gripper finger -->
  <link name="gripper_finger_link1">
    <visual>
      <origin xyz="0.04 0.01 0" rpy="0 0 0" />
      <geometry>
        <box size="${GRIPPER_LENGTH} ${GRIPPER_WIDTH} ${GRIPPER_HEIGHT}" />
      </geometry>
      <material name="White" />
    </visual>
    <collision>
      <origin xyz="0.04 0.01 0" rpy="0 0 0" />
      <geometry>
        <box size="${GRIPPER_LENGTH} ${GRIPPER_WIDTH} ${GRIPPER_HEIGHT}" />
      </geometry>
    </collision>
    <xacro:inertial_matrix mass="1" />
  </link>

  <!-- Right gripper finger (fixed) -->
  <joint name="finger_joint2" type="fixed">
    <origin xyz="0.0 0 0" />
    <parent link="link5" />
    <child link="gripper_finger_link2" />
  </joint>

  <link name="gripper_finger_link2">
    <visual>
      <origin xyz="0.04 0.03 0" />
      <geometry>
        <box size="${GRIPPER_LENGTH} ${GRIPPER_WIDTH} ${GRIPPER_HEIGHT}" />
      </geometry>
      <material name="White" />
    </visual>
    <collision>
      <origin xyz="0.04 0.03 0" />
      <geometry>
        <box size="${GRIPPER_LENGTH} ${GRIPPER_WIDTH} ${GRIPPER_HEIGHT}" />
      </geometry>
    </collision>
    <xacro:inertial_matrix mass="1" />
  </link>

  <!-- ======================== END EFFECTOR ======================== -->
  <link name="grasping_frame" />

  <joint name="grasping_frame_joint" type="fixed">
    <origin xyz="0.08 0 0" rpy="0 0 0" />
    <parent link="link5" />
    <child link="grasping_frame" />
  </joint>

  <!-- ======================== GAZEBO CONFIGURATION ======================== -->
  <gazebo reference="bottom_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="link1">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="link2">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="link3">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="link4">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="link5">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="gripper_finger_link1">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="gripper_finger_link2">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.05</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.03</near>
          <far>5.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_camera" filename="libgazebo_ros_camera.so">
        <frame_name>camera_optical_frame</frame_name>
        <camera_name>camera</camera_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- ROS Control configurations commented out as in original -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      <!-- <plugin>mock_components/GenericSystem</plugin>
        <param name="mock_sensor_commands">false</param>
        <param name="state_following_offset">0.0</param> -->
    </hardware>
    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="joint2">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="joint3">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="joint4">
      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="joint5">
      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="finger_joint1">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">0.0</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>


  <!-- 修改Gazebo插件配置部分 -->
  <!-- <xacro:if value="$(arg sim_gazebo)"> -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find arm_moveit_config)/config/ros2_controllers.yaml</parameters>
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <!-- 添加这些参数来解决话题命名问题 -->
      <robot_namespace></robot_namespace>
      <use_sim_time>true</use_sim_time>
      <!-- 明确指定控制器管理器 -->
      <controller_manager_node_name>controller_manager</controller_manager_node_name>
    </plugin>
  </gazebo>
  <!-- </xacro:if> -->
</robot>