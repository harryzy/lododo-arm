    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: arm_rviz_plugin/ArmControlPanel
    Name: ArmControlPanel
    show_details_enabled: true
    voice_control_enabled: false
