<?xml version="1.0" encoding="UTF-8"?>
<robot name="lekiwi_arm">
    <!--GROUPS: Representation of a set of joints and links-->
    <group name="arm_grp">
        <chain base_link="base_link" tip_link="grasping_frame" />
    </group>
    
    <group name="hand_grp">
        <joint name="finger_joint1" />
        <link name="Moving_Jaw_08d-v1" />
        <link name="grasping_frame" />
    </group>
    
    <!--GROUP STATES: Define named states for particular groups-->
    <group_state name="home" group="arm_grp">
        <joint name="joint1" value="0" />
        <joint name="joint2" value="0" />
        <joint name="joint3" value="0" />
        <joint name="joint4" value="0" />
        <joint name="joint5" value="0" />
    </group_state>
    
    <group_state name="forword" group="arm_grp">
        <joint name="joint1" value="0" />
        <joint name="joint2" value="1.2594" />
        <joint name="joint3" value="0" />
        <joint name="joint4" value="0" />
        <joint name="joint5" value="-0.9368" />
    </group_state>
    
    <group_state name="stop" group="arm_grp">
        <joint name="joint1" value="0" />
        <joint name="joint2" value="-1.7008" />
        <joint name="joint3" value="2.997" />
        <joint name="joint4" value="0.863" />
        <joint name="joint5" value="1.586" />
    </group_state>
    
    <group_state name="open" group="hand_grp">
        <joint name="finger_joint1" value="0" />
    </group_state>
    
    <group_state name="close" group="hand_grp">
        <joint name="finger_joint1" value="-1.5708" />
    </group_state>
    
    <!--END EFFECTOR: Purpose: Represent information about an end effector.-->
    <end_effector name="hand" parent_link="grasping_frame" group="hand_grp" parent_group="arm_grp" />
    
    <!--VIRTUAL JOINT: Purpose: this element defines a virtual joint between a robot link and an external frame of reference (considered fixed)-->
    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_link" />
    
    <!--DISABLE COLLISIONS: Complete matrix - all 231 link pairs disabled-->
    <disable_collisions link1="base_link" link2="base_link_physical" reason="Never" />
